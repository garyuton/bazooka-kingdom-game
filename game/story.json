    },
    {
      "id": "scene007-06",
      "scene": "scene007",
      "text": "「……全然違う。」",
      "speaker": "主人公"
    },
    {
      "id": "scene007-07",
      "scene": "scene007",
      "text": "「何が違うって？」",
      "speaker": "ロマオ王子"
    },
    {
      "id": "scene007-08",
      "scene": "scene007",
      "text": "「……！」",
      "speaker": "主人公"
    },
    {
      "id": "scene007-09",
      "scene": "scene007",
      "text": "「ぶっ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene007-10",
      "scene": "scene007",
      "text": "「みんながチャラいと言っていたので……。」",
      "speaker": "主人公",
      "postDelayMs": 450
    },
    {
      "id": "scene007-11",
      "scene": "scene007",
      "text": "「……聞こえているぞ。」",
      "speaker": "ロマオ王子"
    },
    {
      "id": "scene007-12",
      "scene": "scene007",
      "text": "「い、いやぁ……噂です！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene007-13",
      "scene": "scene007",
      "text": "「そうか。」",
      "speaker": "ロマオ王子",
      "postDelayMs": 500
    },
    {
      "id": "scene007-14",
      "scene": "scene007",
      "text": "「まぁ、間違ってはいない。」",
      "speaker": "ロマオ王子"
    },
    {
      "id": "scene007-15",
      "scene": "scene007",
      "text": "「否定しないんですか？」",
      "speaker": "主人公",
      "postDelayMs": 700
    },
    {
      "id": "scene007-15b",
      "scene": "scene007",
      "text": "「まあな。」",
      "speaker": "ロマオ王子",
      "postDelayMs": 500
    },
    {
      "id": "scene007-16",
      "scene": "scene007",
      "text": "「ところで、地下倉庫から取り出したいものがあるんだ。お願いできるか？」",
      "speaker": "ロマオ王子"
    },
    {
      "id": "scene007-17",
      "scene": "scene007",
      "text": "「地下倉庫……ですか？」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene007-18",
      "scene": "scene007",
      "text": "「お前も行くか？」",
      "speaker": "ロマオ王子"
    },
    {
      "id": "scene007-18b",
      "scene": "scene007",
      "text": "「はい！」",
      "speaker": "主人公"
    },
    {
      "id": "scene007-18c",
      "scene": "scene007",
      "text": "「名前は？」",
      "speaker": "ロマオ王子"
    },
    {
      "id": "scene007-18d",
