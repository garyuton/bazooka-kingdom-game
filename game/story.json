    {
      "id": "scene000-02",
      "scene": "scene000",
      "text": "今日は、ひとつの昔話を聞かせよう。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
