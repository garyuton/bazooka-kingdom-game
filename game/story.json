      "transitionLabelHoldMs": 1700,
      "transitionLabelFadeOutMs": 550
    },
    {
      "id": "scene007-02",
      "scene": "scene007",
      "text": "「噂をすれば、だ。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene007-03",
      "scene": "scene007",
      "text": "「？」",
      "speaker": "主人公",
      "postDelayMs": 600
    },
    {
      "id": "scene007-04",
      "scene": "scene007",
      "text": "「おい、そこの二人。」",
      "speaker": "ロマオ王子",
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        },
        {
          "position": "right",
          "name": "ロマオ",
