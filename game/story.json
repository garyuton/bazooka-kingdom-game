    },
    {
      "id": "scene005-04",
      "scene": "scene005",
      "text": "「地下から荷を運び出したいんだが、人手が足りない。」",
      "speaker": "ロマオ"
    },
    {
      "id": "scene005-05",
      "scene": "scene005",
      "text": "「お任せください！」",
      "speaker": "下男B"
    },
    {
      "id": "scene005-06",
      "scene": "scene005",
      "text": "「助かる。」",
      "speaker": "ロマオ"
    },
    {
      "id": "scene005-07",
      "scene": "scene005",
      "text": "「ん？」",
      "speaker": "ロマオ"
    },
    {
      "id": "scene005-08",
      "scene": "scene005",
      "text": "「{playerName}、お前も来るか？」",
      "speaker": "ロマオ"
    },
    {
      "id": "scene005-09",
      "scene": "scene005",
      "text": "「……はい。」",
      "speaker": "主人公"
    },
    {
      "id": "scene005-10",
      "scene": "scene005",
      "text": "「よし。じゃあ頼んだ。」",
      "speaker": "ロマオ"
    },
    {
      "id": "scene005-11",
