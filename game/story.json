  "scenes": [
    {
      "id": "scene000-01",
      "scene": "scene000",
      "text": "わし、ガリュ㌧。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/images/book/book_closed_01.png?v=20260713-book",
      "characters": [],
      "bgm": null,
      "ambience": null,
      "typeInterval": 72
    },
    {
      "id": "scene000-02",
      "scene": "scene000",
      "text": "今宵は、ひとつの昔話を聞かせよう。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "typeInterval": 65
    },
    {
      "id": "scene000-03",
      "scene": "scene000",
      "text": "これは、雨の夜に拾われた少年と、小さな守護豚の物語じゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "typeInterval": 65
    },
    {
      "id": "scene000-04",
      "scene": "scene000",
      "text": "さぁ、ページをめくろうかの。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "typeInterval": 65,
      "advanceSe": "../assets/audio/se/page_turn_01.mp3?v=20260712-opening",
      "advanceAmbience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "bookTransition": {
        "closed": "../assets/images/book/book_closed_01.png?v=20260713-book",
        "open": "../assets/images/book/book_open_01.png?v=20260713-book",
        "worldBackground": "../assets/cg/scene_royal_carriage_rain_01.png?v=20260712",
        "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
        "ambienceVolume": 0.18,
        "ambienceFadeInMs": 1200,
        "crossFadeMs": 600,
        "holdMs": 800,
        "glowDelayMs": 600,
        "rainDelayMs": 400,
        "worldDelayMs": 200,
        "worldCrossFadeMs": 850,
        "worldHoldMs": 900
      },
      "skipNextTransition": true,
      "nextSceneId": "scene001-01"
    },
    {
      "id": "scene001-01",
      "scene": "scene001",
      "text": "その夜、王と王妃を乗せた馬車は、冷たい雨の中を進んでおった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/cg/scene_royal_carriage_rain_01.png?v=20260712",
      "characters": [],
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.18,
      "ambientSe": "../assets/audio/ambience/bell_far_01.mp3?v=20260704",
      "ambientSeVolume": 0.18,
      "ambientSeKey": "carriage-distant-bell"
    },
    {
      "id": "scene001-02",
      "scene": "scene001",
      "text": "ただの巡幸ではない。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene001-03",
      "scene": "scene001",
      "text": "二人は、いつか現れるという“運命の子”を探しておったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "forceTransition": true,
      "nextSceneId": "scene002a-01"
    },
    {
      "id": "scene002a-01",
      "scene": "scene002a",
      "text": "「……いつの日か、運命の子は現れるのでしょうか。」",
      "background": "../assets/cg/scene_king_queen_carriage_interior_01.png?v=20260712",
      "characters": [],
      "icon": null,
      "speaker": "王妃",
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.08,
      "ambienceFadeToMs": 800,
      "ambientSe": "../assets/audio/ambience/bell_far_01.mp3?v=20260704",
      "ambientSeVolume": 0.05,
      "ambientSeKey": "carriage-distant-bell",
      "ambientSeFadeToMs": 800,
      "transitionMode": "crossfade",
      "transitionDurationMs": 500,
      "postDelayMs": 500
    },
    {
      "id": "scene002a-02",
      "scene": "scene002a",
      "text": "「あの方のお言葉を……今も信じておられるのですね。」",
      "speaker": "王妃"
    },
    {
      "id": "scene002a-03",
      "scene": "scene002a",
      "text": "「豚のおじさんは、嘘をつかぬ。」",
      "speaker": "王",
      "postDelayMs": 800
    },
    {
      "id": "scene002a-04",
      "scene": "scene002a",
      "text": "『豚のおじさん』……。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002a-05",
      "scene": "scene002a",
      "text": "その話は、まだ少し早いの。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002a-06",
      "scene": "scene002a",
      "text": "じゃが、王があれほど信じるには、それだけの理由があったということじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "postDelayMs": 1000,
      "nextSceneId": "scene002b-01"
    },
    {
      "id": "scene002b-01",
      "scene": "scene002b",
      "text": "",
      "background": "../assets/cg/scene_king_queen_carriage_interior_01.png?v=20260712",
      "characters": [],
      "icon": null,
      "speaker": "",
      "hideName": true,
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.08,
      "ambientSe": "../assets/audio/ambience/bell_far_01.mp3?v=20260704",
      "ambientSeVolume": 0.05,
      "ambientSeKey": "carriage-distant-bell",
      "se": "../assets/audio/se/carriage_stop_01.mp3?v=20260718-carriage-stop",
      "seVolume": 0.78,
      "seKey": "scene002b-carriage-stop",
      "effect": "shake",
      "action": "wait",
      "waitMs": 550
    },
    {
      "id": "scene002b-02",
      "scene": "scene002b",
      "text": "「陛下！」",
      "speaker": "御者",
      "effect": null,
      "postDelayMs": 300
    },
    {
      "id": "scene002b-03",
      "scene": "scene002b",
      "text": "「あそこに……子どもが！」",
      "speaker": "御者",
      "postDelayMs": 500,
      "forceTransition": true
    },
    {
      "id": "scene002b-04",
      "scene": "scene002b",
      "text": "雨の向こうに、ひとりの少年がおった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/cg/scene_child_found_in_rain_01.png?v=20260712",
      "characters": [],
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.08,
      "transitionDurationMs": 900,
      "revealOnly": true,
      "startDelayMs": 1700
    },
    {
      "id": "scene002b-05",
      "scene": "scene002b",
      "text": "名もなく、帰る場所もなく……",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002b-06",
      "scene": "scene002b",
      "text": "冷たい雨の中で、ただ静かにうずくまっておったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002b-07",
      "scene": "scene002b",
      "text": "王と王妃は、その少年を馬車へ乗せ、王城へと連れ帰った。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002b-08",
      "scene": "scene002b",
      "text": "それが、すべての始まりじゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "postDelayMs": 1400,
      "forceTransition": true,
      "ambienceFadeOutMs": 1800,
      "nextSceneId": "scene003-01"
    },
    {
      "id": "scene003-01",
      "scene": "scene003",
      "text": "少年が次に目を覚ましたのは、王城の片隅にある、小さな宿舎じゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/bg/servants_dormitory_morning.png?v=20260704",
      "characters": [],
      "bgm": null,
      "ambience": "../assets/audio/ambience/birds_morning_01.mp3?v=20260716-birds",
      "ambienceVolume": 0.22,
      "ambienceFadeInMs": 1200,
      "stopAmbientSeKey": "carriage-distant-bell",
      "startDelayMs": 700
    },
    {
      "id": "scene003-02",
      "scene": "scene003",
      "text": "雨の夜から、一夜が明けておった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene003-03",
      "scene": "scene003",
      "text": "「おっ！　起きたか！」",
      "speaker": "ダンゴ",
      "icon": null,
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ]
    },
    {
      "id": "scene003-04",
      "scene": "scene003",
      "text": "「よかったぁ。お前、ずっと眠ってたんだぞ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-05",
      "scene": "scene003",
      "text": "「……ここは？」",
      "speaker": "主人公"
    },
    {
      "id": "scene003-06",
      "scene": "scene003",
      "text": "「王城だよ。正確には、俺たち下男が寝泊まりしてる宿舎だけどな！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-07",
      "scene": "scene003",
      "text": "「俺はダンゴ。ここで働いてる。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-08",
      "scene": "scene003",
      "text": "「そういや、お前の名前は？」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-09-name",
      "scene": "scene003",
      "text": "",
      "speaker": "",
      "action": "nameInput"
    },
    {
      "id": "scene003-10",
      "scene": "scene003",
      "text": "「……{playerName}。」",
      "speaker": "主人公"
    },
    {
      "id": "scene003-11",
      "scene": "scene003",
      "text": "「{playerName}か！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-12",
      "scene": "scene003",
      "text": "「俺はダンゴ。よろしくな！」",
      "speaker": "ダンゴ",
      "postDelayMs": 700,
      "forceTransition": true,
      "ambienceFadeOutMs": 900,
      "nextSceneId": "scene004-01"
    },
    {
      "id": "scene004-01",
      "scene": "scene004",
      "text": "「ほら、食えよ。」",
      "speaker": "ダンゴ",
      "background": "../assets/bg/bg_servants_dining_hall_day_01.png?v=20260716",
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ],
      "icon": null,
      "bgm": null,
      "ambience": null,
      "transitionDurationMs": 800
    },
    {
      "id": "scene004-02",
      "scene": "scene004",
      "text": "「……いいのか？」",
      "speaker": "主人公"
    },
    {
      "id": "scene004-03",
      "scene": "scene004",
      "text": "「何言ってんだよ。冷めるぞ。」",
      "speaker": "ダンゴ",
      "postDelayMs": 700
    },
    {
      "id": "scene004-04",
      "scene": "scene004",
      "text": "少年にとって、それは久しぶりに口にする温かな食事じゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene004-05",
      "scene": "scene004",
      "text": "そしてこの日から、少年は王城で暮らすことになったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "forceTransition": true,
      "nextSceneId": "scene005-01"
    },
    {
      "id": "scene005-01",
      "scene": "scene005",
      "text": "行くあてのなかった少年は、そのまま王城に身を置き、下男として働くことになった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/bg/bg_castle_courtyard_day_01.png?v=20260716",
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ],
      "bgm": null,
      "ambience": null,
      "transitionDurationMs": 600
    },
    {
      "id": "scene005-02",
      "scene": "scene005",
      "text": "掃除をし、水を運び、薪を運ぶ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene005-03",
      "scene": "scene005",
      "text": "決して楽な毎日ではなかった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene005-04",
      "scene": "scene005",
      "text": "それでも少年は、黙々と働いた。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene005-05",
      "scene": "scene005",
      "text": "いつしか少年は、王城での日々にも馴染んでいったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "postDelayMs": 600
    },
    {
      "id": "scene005-06",
      "scene": "scene005",
      "text": "「おーい、{playerName}！　そっち終わったら手伝ってくれ！」",
      "speaker": "ダンゴ",
      "icon": null
    },
    {
      "id": "scene005-07",
      "scene": "scene005",
      "text": "「分かった！」",
      "speaker": "主人公",
      "forceTransition": true,
      "nextSceneId": "scene006-01"
    },
    {
      "id": "scene006-01",
      "scene": "scene006",
      "text": "仕事を終えた夜。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/bg/bg_servants_dining_hall_night_01.png?v=20260717",
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ],
      "bgm": null,
      "ambience": null,
      "transitionDurationMs": 900,
      "startDelayMs": 1000
    },
    {
      "id": "scene006-02",
      "scene": "scene006",
      "text": "下男たちは食堂に集まり、腹を満たしながら、その日あった出来事を語り合っておった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene006-03",
      "scene": "scene006",
      "text": "「そういや、{playerName}。」",
      "speaker": "ダンゴ",
      "icon": null
    },
    {
      "id": "scene006-04",
      "scene": "scene006",
      "text": "「お前を拾った王様と王妃様には、双子のお子様がいるんだ。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-05",
      "scene": "scene006",
      "text": "「双子……？」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-06",
      "scene": "scene006",
      "text": "「ロマ子姫様と、ロマオ王子。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-07",
      "scene": "scene006",
      "text": "「……王様と王妃様が、俺を助けてくれたんだよね。」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-08",
      "scene": "scene006",
      "text": "「そうらしいな。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-09",
      "scene": "scene006",
      "text": "「だから城のみんな、お前のことを気にしてたんだ。」",
      "speaker": "ダンゴ",
      "postDelayMs": 650
    },
    {
      "id": "scene006-10",
      "scene": "scene006",
      "text": "「ロマ子姫様って、どんな人なの？」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-11",
      "scene": "scene006",
      "text": "「俺たちも話したことはないよ。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-12",
      "scene": "scene006",
      "text": "「遠くから見かけるくらいさ。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-13",
      "scene": "scene006",
      "text": "「でも、髪がすごく綺麗らしい。」",
      "speaker": "ダンゴ",
      "postDelayMs": 500,
      "imagination": {
        "src": "../assets/cg/imagination/img_imagination_romako_01_hair.png?v=20260718",
        "alt": "髪だけを描いたロマ子姫の想像"
      }
    },
    {
      "id": "scene006-14",
      "scene": "scene006",
      "text": "「瞳は、空みたいに青いらしいぞ！」",
      "speaker": "下男A",
      "imagination": {
        "src": "../assets/cg/imagination/img_imagination_romako_02_blue_eyes.png?v=20260718",
        "alt": "両目が青いロマ子姫の想像"
      }
    },
    {
      "id": "scene006-15",
      "scene": "scene006",
      "text": "「いや、夕焼けみたいに赤いと聞いたぞ！」",
      "speaker": "下男B",
      "imagination": {
        "src": "../assets/cg/imagination/img_imagination_romako_03_red_eyes.png?v=20260718",
        "alt": "両目が赤いロマ子姫の想像"
      }
    },
    {
      "id": "scene006-16",
      "scene": "scene006",
      "text": "「どっちなんだよ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-17",
      "scene": "scene006",
      "text": "「…………。」",
      "speaker": "主人公",
      "postDelayMs": 900
    },
    {
      "id": "scene006-18",
      "scene": "scene006",
      "text": "「左が青……右が赤……？」",
      "speaker": "主人公",
      "postDelayMs": 1800,
      "imaginationSequence": [
        {
          "src": "../assets/cg/imagination/img_imagination_romako_04_left_blue_right_red.png?v=20260718",
          "alt": "画面左が青、右が赤の想像",
          "durationMs": 450
        },
        {
          "src": "../assets/cg/imagination/img_imagination_romako_05_left_red_right_blue.png?v=20260718",
          "alt": "画面左が赤、右が青の想像",
          "durationMs": 450
        },
        {
          "src": "../assets/cg/imagination/img_imagination_romako_04_left_blue_right_red.png?v=20260718",
