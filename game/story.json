    {
      "id": "scene005-02",
      "scene": "scene005",
      "text": "「ロマオ王子！」",
      "speaker": "下男A"
    },
    {
      "id": "scene005-03",
      "scene": "scene005",
      "text": "「旅の準備をしていてな。」",
