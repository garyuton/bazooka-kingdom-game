      "id": "scene005-11",
      "scene": "scene005",
      "text": "軽い一言じゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene005-12",
      "scene": "scene005",
      "text": "じゃが、その一言が、少年を運命の地下へ導くことになるのじゃ。",
