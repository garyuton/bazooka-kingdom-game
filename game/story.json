  "scenes": [
    {
      "id": "scene000-01",
      "scene": "scene000",
      "text": "わし、ガリュ㌧。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/images/book/book_closed_01.png?v=20260719-emblem-refresh",
      "characters": [],
      "bgm": null,
      "ambience": null,
      "typeInterval": 72
    },
    {
      "id": "scene000-02",
      "scene": "scene000",
      "text": "今宵は、ひとつの昔話を聞かせよう。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "typeInterval": 65
    },
    {
      "id": "scene000-03",
      "scene": "scene000",
      "text": "これは、雨の夜に拾われた少年と、小さな守護豚の物語じゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "typeInterval": 65
    },
    {
      "id": "scene000-04",
      "scene": "scene000",
      "text": "さぁ、ページをめくろうかの。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "typeInterval": 65,
      "advanceSe": "../assets/audio/se/page_turn_01.mp3?v=20260712-opening",
      "advanceAmbience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "bookTransition": {
        "closed": "../assets/images/book/book_closed_01.png?v=20260719-emblem-refresh",
        "open": "../assets/images/book/book_open_01.png?v=20260713-book",
        "worldBackground": "../assets/cg/scene_royal_carriage_rain_01.png?v=20260712",
        "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
        "ambienceVolume": 0.18,
        "ambienceFadeInMs": 1200,
        "crossFadeMs": 600,
        "holdMs": 800,
        "glowDelayMs": 600,
        "rainDelayMs": 400,
        "worldDelayMs": 200,
        "worldCrossFadeMs": 850,
        "worldHoldMs": 900
      },
      "skipNextTransition": true,
      "nextSceneId": "scene001-01"
    },
    {
      "id": "scene001-01",
      "scene": "scene001",
      "text": "その夜、王と王妃を乗せた馬車は、冷たい雨の中を進んでおった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/cg/scene_royal_carriage_rain_01.png?v=20260712",
      "characters": [],
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.18,
      "ambientSe": "../assets/audio/ambience/bell_far_01.mp3?v=20260704",
      "ambientSeVolume": 0.18,
      "ambientSeKey": "carriage-distant-bell"
    },
    {
      "id": "scene001-02",
      "scene": "scene001",
      "text": "ただの巡幸ではない。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene001-03",
      "scene": "scene001",
      "text": "二人は、いつか現れるという“運命の子”を探しておったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "forceTransition": true,
      "nextSceneId": "scene002a-01"
    },
    {
      "id": "scene002a-01",
      "scene": "scene002a",
      "text": "「……いつの日か、運命の子は現れるのでしょうか。」",
      "background": "../assets/cg/scene_king_queen_carriage_interior_01.png?v=20260712",
      "characters": [],
      "icon": null,
      "speaker": "王妃",
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.08,
      "ambienceFadeToMs": 800,
      "ambientSe": "../assets/audio/ambience/bell_far_01.mp3?v=20260704",
      "ambientSeVolume": 0.05,
      "ambientSeKey": "carriage-distant-bell",
      "ambientSeFadeToMs": 800,
      "transitionDurationMs": 350,
      "transitionBlackHoldMs": 400,
      "startDelayMs": 1200,
      "postDelayMs": 500
    },
    {
      "id": "scene002a-02",
      "scene": "scene002a",
      "text": "「分からぬ……だが、必ず現れる。」",
      "speaker": "王",
      "postDelayMs": 400
    },
    {
      "id": "scene002a-03",
      "scene": "scene002a",
      "text": "「あの方のお言葉を……今も信じておられるのですね。」",
      "speaker": "王妃"
    },
    {
      "id": "scene002a-03b",
      "scene": "scene002a",
      "text": "「豚のおじさんは、嘘をつかぬ。」",
      "speaker": "王",
      "postDelayMs": 800
    },
    {
      "id": "scene002a-04",
      "scene": "scene002a",
      "text": "『豚のおじさん』……。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002a-05",
      "scene": "scene002a",
      "text": "その話は、まだ少し早いかの。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002a-06",
      "scene": "scene002a",
      "text": "じゃが、王がこれほど信じるには、それだけの理由があったということじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "postDelayMs": 1000,
      "nextSceneId": "scene002b-01"
    },
    {
      "id": "scene002b-01",
      "scene": "scene002b",
      "text": "",
      "background": "../assets/cg/scene_king_queen_carriage_interior_01.png?v=20260712",
      "characters": [],
      "icon": null,
      "speaker": "",
      "hideName": true,
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.08,
      "ambientSe": "../assets/audio/ambience/bell_far_01.mp3?v=20260704",
      "ambientSeVolume": 0.05,
      "ambientSeKey": "carriage-distant-bell",
      "effect": "shake",
      "action": "wait",
      "waitMs": 550
    },
    {
      "id": "scene002b-02",
      "scene": "scene002b",
      "text": "「陛下！」",
      "speaker": "御者",
      "effect": null,
      "postDelayMs": 300
    },
    {
      "id": "scene002b-03",
      "scene": "scene002b",
      "text": "「あそこに……子どもが！」",
      "speaker": "御者",
      "postDelayMs": 500,
      "forceTransition": true
    },
    {
      "id": "scene002b-04",
      "scene": "scene002b",
      "text": "雨の向こうに、ひとりの少年がおった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/cg/scene_child_found_in_rain_01.png?v=20260712",
      "characters": [],
      "bgm": null,
      "ambience": "../assets/audio/ambience/rain_loop_01.mp3?v=20260712-rain",
      "ambienceVolume": 0.08,
      "transitionDurationMs": 900,
      "transitionBlackHoldMs": 400,
      "revealOnly": true,
      "startDelayMs": 1700
    },
    {
      "id": "scene002b-05",
      "scene": "scene002b",
      "text": "身寄りもなく、帰る場所さえなく……",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002b-06",
      "scene": "scene002b",
      "text": "冷たい雨の中で、ただ静かにうずくまっておったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002b-07",
      "scene": "scene002b",
      "text": "王と王妃は、その少年を馬車へ乗せ、王城へと連れ帰った。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene002b-08",
      "scene": "scene002b",
      "text": "それが、すべての始まりじゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "postDelayMs": 1400,
      "forceTransition": true,
      "ambienceFadeOutMs": 1800,
      "nextSceneId": "scene002c-01"
    },
    {
      "id": "scene002c-01",
      "scene": "scene002c",
      "text": "少年は王城へ運ばれたあとも眠り続け、目を覚ましたのは翌々日の朝じゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": null,
      "characters": [],
      "bgm": null,
      "ambience": null,
      "transitionDurationMs": 1000,
      "postDelayMs": 900,
      "forceTransition": true,
      "nextSceneId": "scene003-01"
    },
    {
      "id": "scene003-01",
      "scene": "scene003",
      "text": "少年が次に目を覚ましたのは、王城の片隅にある、小さな宿舎じゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/bg/servants_dormitory_morning.png?v=20260704",
      "characters": [],
      "bgm": null,
      "ambience": "../assets/audio/ambience/birds_morning_01.mp3?v=20260716-birds",
      "ambienceVolume": 0.22,
      "ambienceFadeInMs": 1200,
      "stopAmbientSeKey": "carriage-distant-bell",
      "transitionDurationMs": 350,
      "transitionBlackHoldMs": 400,
      "startDelayMs": 700
    },
    {
      "id": "scene003-02",
      "scene": "scene003",
      "text": "窓からは、朝の光が差し込んでおった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene003-03",
      "scene": "scene003",
      "text": "「お！　やっと起きたか！」",
      "speaker": "ダンゴ",
      "icon": null,
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ]
    },
    {
      "id": "scene003-04",
      "scene": "scene003",
      "text": "「お前、昨日は一日ずっと眠ってたんだぞ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-05",
      "scene": "scene003",
      "text": "「ここは……どこですか？」",
      "speaker": "主人公"
    },
    {
      "id": "scene003-06",
      "scene": "scene003",
      "text": "「ここか？　王城だよ。正確には、俺たち下男が寝泊まりしてる宿舎だけどな！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-07",
      "scene": "scene003",
      "text": "「俺はダンゴ。ここで働いてる。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-08",
      "scene": "scene003",
      "text": "「ところで、お前の名前はなんていうんだ？」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-09-name",
      "scene": "scene003",
      "text": "",
      "speaker": "",
      "action": "nameInput"
    },
    {
      "id": "scene003-10",
      "scene": "scene003",
      "text": "「……{playerName}。」",
      "speaker": "{playerName}"
    },
    {
      "id": "scene003-11",
      "scene": "scene003",
      "text": "「{playerName}か、いい名前だな。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene003-12",
      "scene": "scene003",
      "text": "「よろしくな！」",
      "speaker": "ダンゴ",
      "postDelayMs": 700,
      "forceTransition": true,
      "ambienceFadeOutMs": 900,
      "nextSceneId": "scene004-01"
    },
    {
      "id": "scene004-01",
      "scene": "scene004",
      "text": "「ほら、朝食だ。腹へってるだろ？」",
      "speaker": "ダンゴ",
      "background": "../assets/bg/bg_servants_dining_hall_day_01.png?v=20260719-emblem-refresh",
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ],
      "icon": null,
      "bgm": "../assets/audio/bgm/dining_hall_night_01.mp3?v=20260719",
      "bgmVolume": 0.2,
      "bgmFadeInMs": 500,
      "ambience": null,
      "transitionDurationMs": 800
    },
    {
      "id": "scene004-02",
      "scene": "scene004",
      "text": "「……いいんですか？」",
      "speaker": "主人公"
    },
    {
      "id": "scene004-03",
      "scene": "scene004",
      "text": "「何言ってんだよ。冷めるぞ。」",
      "speaker": "ダンゴ",
      "postDelayMs": 700
    },
    {
      "id": "scene004-04",
      "scene": "scene004",
      "text": "少年にとって、久しぶりの温かな食事だったんじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene004-05",
      "scene": "scene004",
      "text": "そしてこの日から、少年は王城で暮らすことになったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "forceTransition": true,
      "nextSceneId": "scene005-01"
    },
    {
      "id": "scene005-01",
      "scene": "scene005",
      "text": "行くあてのなかった少年は、そのまま王城に身を置き、下男として働くことになったんじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/bg/bg_castle_courtyard_day_01.png?v=20260716",
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ],
      "bgm": "../assets/audio/bgm/dining_hall_night_01.mp3?v=20260719",
      "bgmVolume": 0.2,
      "ambience": null,
      "transitionDurationMs": 350,
      "transitionBlackHoldMs": 350
    },
    {
      "id": "scene005-02",
      "scene": "scene005",
      "text": "水を汲み、掃除をし、薪を運ぶ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene005-03",
      "scene": "scene005",
      "text": "決して楽な毎日ではなかった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene005-04",
      "scene": "scene005",
      "text": "それでも少年は、黙々と働いた。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene005-05",
      "scene": "scene005",
      "text": "いつしか少年は、王城での日々にも馴染んでいったのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "postDelayMs": 600
    },
    {
      "id": "scene005-06",
      "scene": "scene005",
      "text": "「おーい、{playerName}！　そっち終わったら手伝ってくれ！」",
      "speaker": "ダンゴ",
      "icon": null
    },
    {
      "id": "scene005-07",
      "scene": "scene005",
      "text": "「はい！　今行きます。」",
      "speaker": "主人公",
      "forceTransition": true,
      "nextSceneId": "scene006-01"
    },
    {
      "id": "scene006-01",
      "scene": "scene006",
      "text": "ある日の食事の時の出来事じゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "background": "../assets/bg/bg_servants_dining_hall_night_01.png?v=20260719-emblem-refresh",
      "characters": [
        {
          "position": "left",
          "name": "ダンゴ",
          "src": "../assets/characters/dango.png?v=20260716"
        }
      ],
      "bgm": "../assets/audio/bgm/dining_hall_night_01.mp3?v=20260719",
      "bgmVolume": 0.2,
      "ambience": null,
      "transitionDurationMs": 350,
      "transitionBlackHoldMs": 350,
      "startDelayMs": 1000
    },
    {
      "id": "scene006-02",
      "scene": "scene006",
      "text": "下男たちは食堂に集まり、腹を満たしながら、その日あった出来事を語り合っておった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene006-03",
      "scene": "scene006",
      "text": "「そういや、{playerName}。」",
      "speaker": "ダンゴ",
      "icon": null
    },
    {
      "id": "scene006-04",
      "scene": "scene006",
      "text": "「お前を拾った王様と王妃様には、双子のお子様がいるんだ。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-05",
      "scene": "scene006",
      "text": "「双子……？」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-06",
      "scene": "scene006",
      "text": "「ロマ子姫と、ロマオ王子。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-07",
      "scene": "scene006",
      "text": "「ロマ子姫とロマオ王子か……。」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-08",
      "scene": "scene006",
      "text": "「お？　興味あるのか？」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-09",
      "scene": "scene006",
      "text": "「ロマ子姫って、どんな人なんですか？」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-11",
      "scene": "scene006",
      "text": "「俺たちも話したことはないよ。遠くから見かけたことがあるくらいさ。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-13",
      "scene": "scene006",
      "text": "「髪が長くて、輝いているんだぜ。」",
      "speaker": "ダンゴ",
      "postDelayMs": 500
    },
    {
      "id": "scene006-14",
      "scene": "scene006",
      "text": "「瞳は、空みたいに青いらしいぞ！」",
      "speaker": "下男A"
    },
    {
      "id": "scene006-15",
      "scene": "scene006",
      "text": "「いや、夕焼けみたいに赤いと聞いたぞ！」",
      "speaker": "下男B"
    },
    {
      "id": "scene006-16",
      "scene": "scene006",
      "text": "「どっちなんだよ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-17",
      "scene": "scene006",
      "text": "「…………。」",
      "speaker": "主人公",
      "postDelayMs": 700
    },
    {
      "id": "scene006-18",
      "scene": "scene006",
      "text": "「……どっちも本当なら……。」",
      "speaker": "主人公",
      "postDelayMs": 1800,
      "imaginationReveal": {
        "src": "../assets/cg/imagination/img_imagination_romako_07_crown.png?v=20260720-mist",
        "alt": "主人公が霧の中に思い描いたロマ子姫",
        "fadeAtMs": 30000
      }
    },
    {
      "id": "scene006-24",
      "scene": "scene006",
      "text": "「こんな感じかな……。」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-25",
      "scene": "scene006",
      "text": "「……まぁ、全部人づてに聞いた噂だけどな。」",
      "speaker": "ダンゴ",
      "imagination": null,
      "imaginationEffect": "mist"
    },
    {
      "id": "scene006-26",
      "scene": "scene006",
      "text": "「俺はいつか親衛隊に入る！」",
      "speaker": "下男A"
    },
    {
      "id": "scene006-27",
      "scene": "scene006",
      "text": "「俺は姫様に会えれば、それでいい！」",
      "speaker": "下男B"
    },
    {
      "id": "scene006-28",
      "scene": "scene006",
      "text": "「夢見すぎだろ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-29",
      "scene": "scene006",
      "text": "「俺はいつか姫様をモノにする！」",
      "speaker": "下男A",
      "postDelayMs": 600
    },
    {
      "id": "scene006-32",
      "scene": "scene006",
      "text": "「……姫様を、モノにする。」",
      "speaker": "主人公",
      "postDelayMs": 800
    },
    {
      "id": "scene006-33",
      "scene": "scene006",
      "text": "「…………。」",
      "speaker": "下男たち",
      "postDelayMs": 400
    },
    {
      "id": "scene006-34",
      "scene": "scene006",
      "text": "「ぶははははは！！」",
      "speaker": "下男たち"
    },
    {
      "id": "scene006-35",
      "scene": "scene006",
      "text": "「お前まで何言ってんだ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-37",
      "scene": "scene006",
      "text": "「……？」",
      "speaker": "主人公"
    },
    {
      "id": "scene006-38",
      "scene": "scene006",
      "text": "少年は、皆に笑われておった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene006-40",
      "scene": "scene006",
      "text": "じゃが、それは少年をからかう笑いではない。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene006-41",
      "scene": "scene006",
      "text": "仲間として、ともに笑い合う声じゃった。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧"
    },
    {
      "id": "scene006-43",
      "scene": "scene006",
      "text": "「じゃあ……ロマオ王子は、どんな方なんですか？」",
      "speaker": "主人公",
      "icon": null
    },
    {
      "id": "scene006-44",
      "scene": "scene006",
      "text": "「ロマオ王子なら、俺たちに仕事を頼みに来ることがあるぞ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-45",
      "scene": "scene006",
      "text": "「この前、王子を城下町で見たぞ！」",
      "speaker": "下男A"
    },
    {
      "id": "scene006-46",
      "scene": "scene006",
      "text": "「娘子に声をかけてた。」",
      "speaker": "下男A"
    },
    {
      "id": "scene006-47",
      "scene": "scene006",
      "text": "「チャラいよなぁ、あの人。」",
      "speaker": "下男B"
    },
    {
      "id": "scene006-48",
      "scene": "scene006",
      "text": "「女好きって話だ。」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-48b",
      "scene": "scene006",
      "text": "「ははははは！」",
      "speaker": "一同"
    },
    {
      "id": "scene006-49",
      "scene": "scene006",
      "text": "「だが、剣だけは別だ。」",
      "speaker": "下男A"
    },
    {
      "id": "scene006-51",
      "scene": "scene006",
      "text": "「俺、見たことある！　マントン三銃士の剣をひょいっとかわして、一瞬で弾き落としたんだ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-53",
      "scene": "scene006",
      "text": "「普段は軽そうに見えるが、剣を握れば人が変わる。あれは本物だ。」",
      "speaker": "下男A"
    },
    {
      "id": "scene006-54b",
      "scene": "scene006",
      "text": "「お前に本物が分かるのかよ！」",
      "speaker": "ダンゴ"
    },
    {
      "id": "scene006-54c",
      "scene": "scene006",
      "text": "「ははははは！」",
      "speaker": "一同"
    },
    {
      "id": "scene006-55",
      "scene": "scene006",
      "text": "少年はその夜、まだ会ったこともない二人の王族を、心の中に思い描いたのじゃ。",
      "speaker": "",
      "hideName": true,
      "icon": "../assets/characters/garyuton.png?v=20260704",
      "iconAlt": "ガリュ㌧",
      "forceTransition": true,
      "nextSceneId": "scene007-01"
    },
    {
      "id": "scene007-01",
      "scene": "scene007",
      "text": "「……あ。」",
      "speaker": "ダンゴ",
      "background": "../assets/bg/bg_castle_courtyard_day_01.png?v=20260716",
      "characters": [
        {
          "position": "left",
