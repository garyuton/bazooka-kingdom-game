      "nextSceneId": "scene008-01"
    },
    {
      "id": "scene008-01",
      "scene": "scene008",
      "text": "「……ここから降りるんですか？」",
      "speaker": "主人公",
      "background": "../assets/bg/bg_castle_underground_entrance_01.png?v=20260716",
