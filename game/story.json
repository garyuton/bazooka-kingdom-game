      "id": "scene005-07",
      "scene": "scene005",
      "text": "「ん？」",
      "speaker": "ロマオ"
    },
    {
      "id": "scene005-08",
      "scene": "scene005",
      "text": "「{playerName}、お前も来るか？」",
      "speaker": "ロマオ"
    },
    {
      "id": "scene005-09",
      "scene": "scene005",
      "text": "「……はい。」",
      "speaker": "主人公"
    },
    {
      "id": "scene005-10",
      "scene": "scene005",
      "text": "「よし。じゃあ頼んだ。」",
      "speaker": "ロマオ"
