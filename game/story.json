    },
    {
      "id": "scene007-04b",
      "scene": "scene007",
      "text": "「ん？」",
      "speaker": "ロマオ王子"
    },
    {
      "id": "scene007-04c",
      "scene": "scene007",
      "text": "「見ない顔だな。」",
